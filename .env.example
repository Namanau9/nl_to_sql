# ============================================================================
# Natural Language -> SQL Analytics Assistant
# Environment variable examples. Copy to .env and fill in real values.
# NEVER commit real secrets.
# ============================================================================

# --- Database (PostgreSQL) ---
# URL used for schema discovery / maintenance (owner role).
DATABASE_URL=postgresql+psycopg://nlsql_app:NLSQL_APP_PASSWORD@localhost:5432/nlsql

# URL used for executing LLM-generated queries (READ-ONLY role).
READONLY_DATABASE_URL=postgresql+psycopg://nlsql_readonly:NLSQL_READONLY_PASSWORD@localhost:5432/nlsql

# --- LLM ---
# Provider key + endpoint. Leave LLM_API_KEY empty to use the MockProvider.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# --- Query limits / guardrails ---
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000
MAX_REPAIR_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=30

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
