# Natural Language to SQL Analytics Assistant - env example
DATABASE_URL=postgresql+psycopg://nlsql_app:NLSQL_APP_PASSWORD@localhost:5432/nlsql
READONLY_DATABASE_URL=postgresql+psycopg://nlsql_readonly:NLSQL_READONLY_PASSWORD@localhost:5432/nlsql
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-v1-your-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000
MAX_REPAIR_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=30
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]